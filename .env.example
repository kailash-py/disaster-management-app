# SANKATMOCHAN — Environment Configuration Template
# SIH 2026 Problem Statement SIH26191
# Production & Demonstration Environment Settings

# Map Tile Provider (Default: CartoDB / OpenStreetMap - zero cost, no key required)
VITE_MAP_PROVIDER=openstreetmap
VITE_OSRM_URL=https://router.project-osrm.org

# Multi-Hazard Hydro-Meteorological Forecast API (Optional - uses simulated fallback if omitted)
VITE_WEATHER_API_KEY=
VITE_CWC_TELEMETRY_ENDPOINT=

# Backend Services (Optional for demo, falls back to deterministic client engine)
VITE_BACKEND_URL=http://localhost:8000

# Government Common Alerting Protocol (CAP) / SACHET Integration
# Set to 'true' to use simulated demo alerts; set to 'false' in authorized deployment
DEMO_ALERT_PROVIDER=true

# Security Notice:
# Never commit real API keys, passwords, or production tokens into version control.
